<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A281E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LegacyVault DMS"
            android:textColor="#E0C486"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:gravity="center"
            android:text="🌐 Máy chủ: Đang tải..."
            android:textColor="#7DAFA0"
            android:textSize="9sp" />

        <!-- KHUNG CHƯA GHÉP NỐI (NHẬP MÃ PIN TỪ WEB) -->
        <LinearLayout
            android:id="@+id/layoutUnpaired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🔗 Ghép nối đồng hồ"
                android:textColor="#85E5B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPairGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Lấy mã 6 số tại Web Dashboard"
                android:textColor="#A0B8AF"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/etPairCode"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="#163D2F"
                android:gravity="center"
                android:hint="Nhập 6 số"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="#FFFFFF"
                android:textColorHint="#5E8A79"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSubmitPair"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E0C486"
                android:text="XÁC NHẬN"
                android:textColor="#0A281E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- KHUNG ĐÃ GHÉP NỐI (ĐO NHỊP TIM & ĐIỂM DANH) -->
        <LinearLayout
            android:id="@+id/layoutPaired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOwnerEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="👤 Chủ kho"
                android:textColor="#85E5B8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minLines="2"
                android:text="Sẵn sàng đo nhịp tim"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCheckIn"
                android:layout_width="140dp"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E0C486"
                android:text="💓 ĐIỂM DANH"
                android:textColor="#0A281E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUnpair"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#2D1B1B"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Đổi tài khoản"
                android:textColor="#E08686"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
